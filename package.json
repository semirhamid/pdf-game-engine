{
  "name": "pdf-dungeon",
  "version": "1.0.0",
  "description": "A dungeon crawler that runs inside a PDF.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node src/build/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.e2e.ts",
    "poc": "node poc/build-probe.ts && node poc/build-input-probe.ts && node poc/build-bench.ts",
    "bot": "node tools/bot.ts",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "record": "node tools/record.ts",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "typescript": "5.9"
  }
}
